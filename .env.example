# ── english-edit 环境配置模板 ──
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会入库。
# docker-compose 部署时，项目根 .env 会被 compose 自动读取以填充 ${VAR}。

# ── 数据库 / 缓存 ──
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/english_edit
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=replace-with-random-password

# ── DeepSeek LLM（OpenAI 兼容）──
# TODO: 填入真实 API Key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash

# ── 成本估算（每 1000 token）──
COST_PER_1K_TOKENS=0.002

# ── 质检 LLM 采样次数 / 人工质检阈值 ──
# 默认 1 轮：rubric 已使单次打分稳定；需进一步降噪时调高（如 3）。
JUDGE_SAMPLE_ROUNDS=1
QUALITY_THRESHOLD=70.0

# ── Langfuse 可观测性（留空则关闭）──
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── RAG 向量检索（阿里云百炼 text-embedding-v3）──
# TODO: 填入真实 API Key
EMBEDDING_API_BASE=https://your-embedding-provider.example/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_DIM=1024

# ── 运行环境与持久化断点 ──
ENVIRONMENT=development
CHECKPOINTER_BACKEND=postgres
ALLOW_MEMORY_CHECKPOINTER=false

# ── JWT / 管理员账号（生产必须使用强随机值）──
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=43200
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-random-admin-password

# ── Langfuse v2（Compose 生产启动必填）──
LANGFUSE_NEXTAUTH_SECRET=replace-with-random-nextauth-secret
LANGFUSE_SALT=replace-with-random-salt
# 必填：请替换为随机生成的 32 字节密钥
LANGFUSE_ENCRYPTION_KEY=
